{
  "name": "com.olympian.app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "postinstall": "patch-package",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "detox test",
    "test:e2e:build:ios": "detox build --configuration ios.sim.debug",
    "test:e2e:build:android": "detox build --configuration android.emu.debug",
    "assets:bake": "ts-node --project tsconfig.scripts.json scripts/bake-assets.ts",
    "db:build": "ts-node --project tsconfig.scripts.json scripts/build-db.ts",
    "db:seed": "ts-node --project tsconfig.scripts.json scripts/seed-db.ts",
    "content:validate": "ts-node --project tsconfig.scripts.json scripts/validate-content.ts",
    "i18n:coverage": "ts-node --project tsconfig.scripts.json scripts/i18n-coverage.ts",
    "perf:check": "ts-node --project tsconfig.scripts.json scripts/perf-check.ts",
    "prebuild": "npm run assets:bake && npm run db:build && npm run content:validate && npm run i18n:coverage",
    "build:ios:dev": "npm run prebuild && react-native run-ios",
    "build:ios:release": "npm run prebuild && cd ios && xcodebuild -workspace Olympian.xcworkspace -scheme Olympian -configuration Release",
    "build:android:dev": "npm run prebuild && react-native run-android",
    "build:android:release": "npm run prebuild && cd android && ./gradlew assembleRelease",
    "ci": "npm run lint && npm run typecheck && npm test && npm run prebuild"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.6.3",
    "@op-engineering/op-sqlite": "^11.0.0",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/native": "^7.0.13",
    "@react-navigation/native-stack": "^7.1.13",
    "@shopify/react-native-skia": "2.4.0",
    "i18next": "^23.16.4",
    "immer": "^10.1.1",
    "nanoid": "^5.0.7",
    "react": "19.2.3",
    "react-i18next": "^15.1.1",
    "react-native": "0.87.1",
    "react-native-config": "^1.5.3",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-iap": "15.0.0",
    "react-native-localize": "^3.3.0",
    "react-native-mmkv": "^3.1.0",
    "react-native-nitro-modules": "0.35.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.27.0",
    "react-native-sound": "^0.11.2",
    "react-native-worklets": "0.12.2",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "detox": "^20.27.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
